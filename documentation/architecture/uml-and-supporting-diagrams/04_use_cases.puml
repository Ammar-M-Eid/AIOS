  usecase "UC-08\nAuthenticate and revalidate actuator request" as UC08
  usecase "UC-09\nApply guarded CPU control" as UC09
  usecase "UC-10\nApply guarded RAM control" as UC10
  usecase "UC-11\nApply guarded device-specific I/O control" as UC11
  usecase "UC-12\nInhibit and recover on unsafe runtime" as UC12
