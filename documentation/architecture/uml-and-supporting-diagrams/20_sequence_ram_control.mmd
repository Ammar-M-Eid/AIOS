%% SEQ-05: RAM guarded actuation
%% Behavior trace is in 02_Requirements/AIOS_Requirement_Behavior_Traceability.csv
sequenceDiagram
    autonumber
    participant POL as Policy Service
    participant ACT as Resource Manager / Actuator
    participant K as cgroups v2 memory
    participant AUD as Audit DB
    POL->>ACT: Bounded memory request over authenticated local IPC
    ACT->>ACT: Authenticate peer, revalidate mode, target, bounds and ownership
    alt Guard fails
        ACT->>AUD: Deny, no kernel write
    else Guard passes
        ACT->>K: Read prior memory.high
        Note over ACT,K: memory.max is prohibited, no process termination
        ACT->>K: Write bounded memory.high
        ACT->>K: Read back effective value
        alt Verified
            ACT->>AUD: Record applied value and result
        else Failure
            ACT->>ACT: Recheck identity and ownership
            opt Still verified
                ACT->>K: Restore captured prior memory.high and verify
            end
            ACT->>AUD: Record failure and recovery outcome
        end
    end
