@startuml
!include <C4/C4_Component>
skinparam componentStyle uml1
title C4 Component Diagram — Resource Manager / Actuator
LAYOUT_LEFT_RIGHT()
AddRelTag("dashed", $lineStyle=DashedLine())
Container_Boundary(scope, "Resource Manager / Actuator") {
  Component(C1, "Unix Socket Endpoint", "Python · Unix domain socket", "Accepts admitted requests and returns outcomes on the same connection.")
  Component(C2, "Peer Credential Guard", "SO_PEERCRED", "Checks kernel peer identity against the approved caller policy.")
  Component(C3, "Request Shape & Action Guard", "Request validation", "Checks action fields, resource whitelist, numeric bounds, and mode.")
  Component(C4, "Process & Cgroup Guard", "procfs · cgroups v2", "Rechecks PID identity, ownership, target cgroup, and resource capability.")
  Component(C5, "Bounded Resource Adapter", "cgroups v2", "Applies and reads back gated cpu.weight, memory.high, or supported io.weight/io.max.")
  Component(C6, "Audit Event Writer", "Append-only host-local log", "Records denials, action, read-back, recovery, and failure outcomes.")
}
Container_Ext(S1, "Decision & Policy Client", "Supporting service", "Directly connected container outside the scope")
Container_Ext(S2, "Safety Watchdog Recovery Client", "Supporting service", "Directly connected container outside the scope")
ContainerDb_Ext(S3, "Audit Store", "SQLite · separate local database", "Proposed persistent data store outside this scoped container")
System_Ext(S4, "Ubuntu kernel · SO_PEERCRED", "Host-provided Linux interface")
System_Ext(S5, "Ubuntu procfs / cgroups v2", "Host-provided Linux interface")
System_Ext(S6, "Ubuntu cgroups v2", "Host-provided Linux interface")
Rel(S1, C1, "calls the authenticated actuator", "IActuatorEndpoint", $tags="dashed")
Rel(S2, C1, "calls the authenticated actuator", "IActuatorEndpoint", $tags="dashed")
Rel(C1, C2, "uses peer authentication from", "IPeerAuth", $tags="dashed")
Rel(C3, C2, "uses authenticated request from", "IAuthenticatedRequest", $tags="dashed")
Rel(C4, C3, "validates request using", "IRequestValidation", $tags="dashed")
Rel(C4, C5, "requests bounded change from", "IResourceApply", $tags="dashed")
Rel(C5, C4, "uses approved target from", "IApprovedTarget", $tags="dashed")
Rel(C5, C6, "sends event to audit writer", "IAuditAppend", $tags="dashed")
Rel(C6, S3, "appends audit record to", "IAuditStoreWrite", $tags="dashed")
Rel(C2, S4, "reads peer credentials from", "IPeerCredentialRead", $tags="dashed")
Rel(C4, S5, "revalidates process and cgroup through", "IProcessCgroupRead", $tags="dashed")
Rel(C5, S6, "writes and reads back through", "ICgroupResourceControl", $tags="dashed")
note bottom
This editable source uses C4 element and relationship macros. The synchronized SVG/PDF/PNG/JPG rendering adds the requested UML1 component tabs, square ports, required sockets, and provided lollipops. Dashed dependency arrows are the project convention.
end note
SHOW_LEGEND()
@enduml
